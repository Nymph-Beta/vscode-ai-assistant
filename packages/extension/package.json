{
  "name": "vscode-tools",
  "displayName": "vscode-tools",
  "description": "A VS Code extension with useful tools",
  "version": "0.0.1",
  "publisher": "dwr2001",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwr2001/vscode-tools.git"
  },
  "engines": {
    "node": ">=18",
    "vscode": ">=1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-tools.helloWorld",
        "title": "VSCode Tools: Hello World"
      },
      {
        "command": "vscode-tools.mode.code",
        "title": "VSCode Tools: 切换到代码模式"
      },
      {
        "command": "vscode-tools.mode.architect",
        "title": "VSCode Tools: 切换到架构师模式"
      },
      {
        "command": "vscode-tools.mode.ask",
        "title": "VSCode Tools: 切换到提问模式"
      },
      {
        "command": "vscode-tools.mode.debug",
        "title": "VSCode Tools: 切换到调试模式"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-tools-sidebar",
          "title": "VSCode Tools",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "vscode-tools-sidebar": [
        {
          "id": "vscode-tools.view",
          "name": "VSCode Tools",
          "type": "webview"
        }
      ]
    },
    "configuration": [
      {
        "title": "AI 服务",
        "properties": {
          "vscode-tools.ai.provider": {
            "type": "string",
            "default": "openai",
            "enum": ["openai", "anthropic", "gemini", "ollama", "openrouter", "custom"],
            "enumDescriptions": [
              "OpenAI - GPT-4o, GPT-4 Turbo 等模型",
              "Anthropic - Claude 3.5 Sonnet, Claude 3 Opus 等模型",
              "Google Gemini - Gemini 1.5 Pro, Gemini 1.5 Flash 等模型",
              "Ollama - 本地运行的开源模型 (Llama, Mistral 等)",
              "OpenRouter - 统一接口访问多种模型",
              "自定义 - OpenAI 兼容的自定义 API"
            ],
            "description": "AI 服务提供商"
          },
          "vscode-tools.ai.apiKey": {
            "type": "string",
            "default": "",
            "description": "API Key"
          },
          "vscode-tools.ai.baseURL": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "description": "API 基础 URL（Ollama 默认: http://localhost:11434）"
          },
          "vscode-tools.ai.model": {
            "type": "string",
            "default": "gpt-4o-mini",
            "description": "模型名称"
          },
          "vscode-tools.ai.thinkTag": {
            "type": "boolean",
            "default": false,
            "description": "是否启用思考标签解析（用于 DeepSeek 等支持思考的模型）"
          }
        }
      },
      {
        "title": "模式设置",
        "properties": {
          "vscode-tools.modes.defaultMode": {
            "type": "string",
            "default": "code",
            "enum": ["code", "architect", "ask", "debug"],
            "enumDescriptions": [
              "代码模式 - 日常编码、编辑和文件操作",
              "架构师模式 - 规划系统、规范和迁移（只读）",
              "提问模式 - 快速回答、解释和文档（只读）",
              "调试模式 - 跟踪问题、添加日志"
            ],
            "description": "默认工作模式"
          },
          "vscode-tools.modes.disabledModes": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "禁用的模式列表"
          }
        }
      },
      {
        "title": "上下文管理",
        "properties": {
          "vscode-tools.context.contextWindow": {
            "type": "number",
            "default": 128000,
            "description": "上下文窗口大小（tokens）"
          },
          "vscode-tools.context.condenseThreshold": {
            "type": "number",
            "default": 80,
            "minimum": 50,
            "maximum": 95,
            "description": "触发对话压缩的阈值（百分比）"
          },
          "vscode-tools.context.enableCondensation": {
            "type": "boolean",
            "default": true,
            "description": "是否启用自动对话压缩"
          }
        }
      },
      {
        "title": "代码索引",
        "properties": {
          "vscode-tools.codeIndex.enabled": {
            "type": "boolean",
            "default": false,
            "description": "是否启用代码语义索引"
          },
          "vscode-tools.codeIndex.embeddingProvider": {
            "type": "string",
            "default": "openai",
            "enum": ["openai", "ollama"],
            "description": "嵌入向量提供商"
          },
          "vscode-tools.codeIndex.embeddingModel": {
            "type": "string",
            "default": "text-embedding-3-small",
            "description": "嵌入模型名称"
          },
          "vscode-tools.codeIndex.minSearchScore": {
            "type": "number",
            "default": 0.3,
            "minimum": 0,
            "maximum": 1,
            "description": "语义搜索最小相似度分数"
          },
          "vscode-tools.codeIndex.maxSearchResults": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "description": "语义搜索最大结果数"
          }
        }
      },
      {
        "title": "自动批准设置",
        "properties": {
          "vscode-tools.autoApproval.enabled": {
            "type": "boolean",
            "default": false,
            "description": "启用自动批准功能（启用后，符合条件的工具将自动执行）"
          },
          "vscode-tools.autoApproval.alwaysAllowReadOnly": {
            "type": "boolean",
            "default": true,
            "description": "自动批准只读工具（read_file, list_files, search_files, codebase_search）"
          },
          "vscode-tools.autoApproval.alwaysAllowWrite": {
            "type": "boolean",
            "default": false,
            "description": "自动批准写入工具（write_to_file, edit_file, apply_diff）"
          },
          "vscode-tools.autoApproval.alwaysAllowExecute": {
            "type": "boolean",
            "default": false,
            "description": "自动批准命令执行（需配合 allowedCommands/deniedCommands）"
          },
          "vscode-tools.autoApproval.allowedCommands": {
            "type": "array",
            "default": ["npm ", "pnpm ", "yarn ", "git status", "git diff", "git log", "ls ", "cat ", "echo "],
            "items": {
              "type": "string"
            },
            "description": "允许自动执行的命令前缀列表"
          },
          "vscode-tools.autoApproval.deniedCommands": {
            "type": "array",
            "default": ["rm -rf", "sudo", "rm -r /", "mkfs", "dd if=", "chmod 777", "> /dev/"],
            "items": {
              "type": "string"
            },
            "description": "禁止执行的危险命令（会被自动拒绝）"
          },
          "vscode-tools.autoApproval.timeoutMs": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 60000,
            "description": "超时自动批准时间（毫秒），0 表示禁用。用户在此时间内无操作将自动批准"
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "rsbuild build",
    "watch": "rsbuild build --watch",
    "check": "biome check --write",
    "format": "biome format --write",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.2",
    "@vscode/vsce": "^3.6.0"
  }
}
